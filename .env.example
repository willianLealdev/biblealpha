# Copie para .env e ajuste. Em homologação/produção configure estas variáveis no Easypanel.
# Nunca coloque o arquivo .env no Git.

# development | staging | production
BA_ENV=development

# URL pública do app (links dos e-mails de confirmação e de redefinição de senha)
BA_APP_URL=http://localhost:8080

BA_DATABASE_URL=postgresql+asyncpg://biblealpha:biblealpha@localhost:5432/biblealpha
BA_REDIS_URL=redis://localhost:6379/0

# Gere com:  py -c "import secrets; print(secrets.token_urlsafe(48))"
BA_JWT_SECRET=

# console (mostra o link no log) | resend
BA_EMAIL_BACKEND=console
BA_EMAIL_FROM=BibleAlpha <no-reply@biblealpha.com>
BA_RESEND_API_KEY=

# Só se o app web ficar em outra origem (o padrão é servir a API em /api no mesmo domínio)
# Produção: BA_APP_URL=https://biblealpha.com e BA_CORS_ORIGINS=["https://biblealpha.com"]

# Chaves das integrações (Anthropic, OpenAI, Resend, Stripe): o normal é cadastrá-las no
# painel do admin → Integrações e chaves (ficam criptografadas no banco). As variáveis abaixo
# continuam valendo como alternativa quando a chave não estiver no painel.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# BA_STRIPE_SECRET_KEY=
# BA_STRIPE_WEBHOOK_SECRET=

# Chave que criptografa as chaves do painel (se vazia, deriva de BA_JWT_SECRET).
# Se for trocada, as chaves precisam ser cadastradas de novo no painel.
# BA_SECRETS_KEY=

# IA: auto (Claude quando houver chave; sem chave, respostas de teste só em desenvolvimento)
# BA_AI_PROVIDER=auto

# Importa sozinho todas as Bíblias redistribuíveis do eBible.org (~1.300, mais de mil idiomas)
# e confere atualizações toda semana. Padrão: ligado em staging/produção, desligado em desenvolvimento.
# BA_BIBLE_AUTO_IMPORT=true
