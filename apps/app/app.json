{
  "expo": {
    "name": "BibleAlpha",
    "slug": "biblealpha",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "biblealpha",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0806",
    "ios": {
      "bundleIdentifier": "com.biblealpha.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.biblealpha.app",
      "adaptiveIcon": {
        "backgroundColor": "#040302",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "name": "BibleAlpha",
      "shortName": "BibleAlpha",
      "themeColor": "#0A0806",
      "backgroundColor": "#0A0806",
      "favicon": "./public/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040302",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "BibleAlpha uses the camera only to scan the QR code of the church screen.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "BibleAlpha uses the microphone so you can dictate your messages and questions.",
          "speechRecognitionPermission": "BibleAlpha turns your voice into text when you dictate messages and questions."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Bíblia, estudo com IA, devocional diário e ministrações — do estudo ao púlpito.",
    "githubUrl": "https://github.com/willianLealdev/biblealpha",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "pt": "./locales/pt.json",
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}
